# Weather
OPENWEATHER_API_KEY=your_openweather_api_key
WEATHER_LOCATION=Victoria,CA
WEATHER_UNITS=metric

# Calendar
CALENDAR_ICS_URL=https://calendar.google.com/calendar/ical/your-calendar-id/public/basic.ics

# BC Transit
BC_TRANSIT_API_KEY=your_bc_transit_api_key
BC_TRANSIT_REGION=victoria
BC_TRANSIT_STOP_ID=123456

# Voice Assistant
VOICE_ASSISTANT_LANG=en-CA
VOICE_ASSISTANT_WAKE="hey mirror"
VOICE_TTS_BACKEND=pyttsx3  # "pyttsx3" (offline) or "openai"
VOICE_TTS_MODEL=gpt-4o-mini-tts
VOICE_TTS_VOICE=alloy
OPENAI_API_KEY=your-openai-key

# Motion + slideshow
MOTION_ENABLED=true
MOTION_GPIO_PIN=17
MOTION_ABSENCE_COOLDOWN=45
SLIDESHOW_DIR=slides
SLIDESHOW_INTERVAL=30

# Media playback (mpv recommended)
MEDIA_VIDEO_PLAYER=mpv
MEDIA_AUDIO_PLAYER=mpv
MEDIA_DEFAULT_MUSIC="lofi hip hop radio"
MEDIA_DEFAULT_VIDEO="news livestream"

# Astronomy + Aurora
ASTRONOMY_LOCATION=Victoria,CA
AURORA_LAT=48.4284
AURORA_LON=-123.3656
